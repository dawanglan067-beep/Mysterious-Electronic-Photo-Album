MainWindow {
    background-color: rgb(46,47,48);
}

/* 菜单栏颜色 */
QMenuBar {
    color: rgb(231,231,231); /* 文字颜色 */
    background-color: rgb(46,47,48); /* 背景颜色 */
}

/* 菜单项颜色 */
QMenu {
    color: rgb(231,231,231); /* 文字颜色 */
    background: rgb(55,55,55); /* 背景颜色 */
}

/* 选中菜单项时的样式 */
QMenuBar::item:selected {
    background-color: rgb(80,80,80); /* 选中时背景 */
}

/* 选中菜单项时的样式 */
QMenu::item:selected {
    background-color: rgb(39,96,154 ); /* 选中时背景 */
}

/* 创建相册向导样式：确保背景与文字颜色严格成对绑定 */
QWizard {
    background-color: rgb(46,47,48);
    color: rgb(231,231,231);
}

/* 向导页及其子页面容器背景与字体 */
QWizard QWizardPage, QWizard ProSetPage, QWizard ConfirmPage {
    background-color: rgb(46,47,48);
    color: rgb(231,231,231);
}

/* 向导内所有文本标签 */
QWizard QLabel {
    background-color: transparent;
    color: rgb(231,231,231);
}

/* 提示红字：使用多重选择器确保精准生效 */
#tips, QLabel#tips, QWizard QLabel#tips {
    background-color: transparent;
    color: rgb(255,80,80);
}

/* 输入框 */
QWizard QLineEdit {
    background-color: rgb(67,67,70);
    color: rgb(231,231,231);
    border: 1px solid rgb(120,120,120);
    border-radius: 3px;
    padding: 3px 5px;
}

ProTree {
    border-color: #9F9F9F;
    border-style: solid;
    border-width: 1px 1px 1px 1px;
    padding-right: 10px;
    background-color: rgb(46,47,48);
    color: rgb(231,231,231);
}

QLabel#label_pro, QLabel#lable_pro {
    color: rgb(231,231,231);
    border-color: #9F9F9F;
    border-style: dotted;
    border-width: 0 0 1px 0;
    padding-bottom: 10px;
    margin-bottom: 5px;
}

QTreeWidget {
    color: rgb(231,231,231);
    background-color: rgb(67,67,70);
    border: 0px;
}

QTreeWidget::item:hover {
    background: rgb(38,95,153);
}

QTreeWidget::item:selected {
    background: rgb(38,95,153);
}


PicShow {
    border-color: #9F9F9F;
    border-style: solid;
    border-width: 1px 1px 1px 1px;
    padding: 10px;
    background: rgb(64,66,68);
}

#canvasToolbar {
    background-color: rgb(42, 44, 47);
    border: 1px solid rgb(78, 81, 86);
    border-radius: 6px;
}

#canvasToolBtn {
    background-color: rgb(56, 59, 64);
    color: rgb(225, 228, 232);
    border: 1px solid rgb(88, 92, 98);
    border-radius: 4px;
    padding: 3px 10px;
    font-size: 12px;
}

#canvasToolBtn:hover {
    background-color: rgb(45, 105, 168);
    border-color: rgb(80, 145, 215);
}

#canvasToolBtn:pressed, #canvasToolBtn:checked {
    background-color: rgb(35, 85, 140);
    border-color: rgb(100, 165, 235);
}

#inspectorPanel {
    background-color: rgb(43, 45, 48);
    border-left: 1px solid rgb(82, 85, 90);
}

#inspectorSectionTitle {
    color: rgb(235, 238, 242);
    font-weight: bold;
    font-size: 13px;
    padding-top: 2px;
}

#studioCombo, QComboBox {
    background-color: rgb(58, 60, 65);
    color: rgb(230, 233, 238);
    border: 1px solid rgb(95, 98, 105);
    border-radius: 4px;
    padding: 3px 8px;
}

QComboBox QAbstractItemView {
    background-color: rgb(50, 52, 56);
    color: rgb(230, 233, 238);
    selection-background-color: rgb(38, 95, 153);
}

QSlider::groove:horizontal {
    height: 4px;
    background: rgb(80, 84, 90);
    border-radius: 2px;
}

QSlider::sub-page:horizontal {
    background: rgb(55, 130, 210);
    border-radius: 2px;
}

QSlider::handle:horizontal {
    background: rgb(225, 230, 238);
    border: 1px solid rgb(55, 130, 210);
    width: 12px;
    margin: -5px 0;
    border-radius: 6px;
}

#nextBtn,#previousBtn,#closeBtn,#playBtn,#slidepreBtn,#slidenextBtn,#slidpreBtn,#slidnextBtn {
    background-color: transparent;
    border: 1px solid transparent;
    border-radius: 10px;
    padding: 4px;
}

PicBtn:hover, PicStateBtn:hover {
    background-color: rgb(48, 61, 77);
    border-color: rgb(76, 101, 130);
}

PicBtn:pressed, PicStateBtn:pressed {
    background-color: rgb(34, 51, 70);
    border-color: rgb(83, 150, 216);
}


SlideShowDlg, SlidShowDlg{
    color:rgb(231,231,231);
    background-color:rgb(46,47,48);

}

#preListWidget{
    color:rgb(231,231,231);
    background-color:rgb(46,47,48);
    border:0px;
}

#preListWidget::item:hover{
    background:rgb(38,95,153);
}

#preListWidget::item:selected{
    background:rgb(38,95,153);
}

#slideprewid,#slidprewid{
    margin-left:10px;
}

#slidenextwid,#slidnext{
    margin-right:10px;
}

#preListWidget::item:selected:active{
    border:2px solid #ffffff;
}

#preListWidget::item:selected{
    border:2px solid #ffffff;
}

RemoveProDialog {
    background-color: rgb(46, 47, 48);
    color: rgb(231, 231, 231);
}

RemoveProDialog QLabel {
    color: rgb(231, 231, 231);
    font-size: 13px;
}

RemoveProDialog QCheckBox {
    color: rgb(255, 120, 120);
    font-weight: bold;
    spacing: 8px;
    padding: 6px;
}

RemoveProDialog QCheckBox::indicator {
    width: 18px;
    height: 18px;
    border: 1px solid rgb(140, 140, 140);
    border-radius: 3px;
    background-color: rgb(60, 60, 63);
}

RemoveProDialog QCheckBox::indicator:hover {
    border-color: rgb(60, 140, 230);
}

RemoveProDialog QCheckBox::indicator:checked {
    background-color: rgb(215, 60, 60);
    border-color: rgb(255, 80, 80);
}



